# Store some HTML on your computer
library(httr)
# Fetch the  page on Web Scraping
url <- "https://www.visitstockholm.com/events/?"
response <- GET(url)
html <- content(response, as = 'text')
# Write it to a file "visitstockholm.html"
writeLines(html, "visitstockholm.html")
# At a later point, you can read it in:
lines <- readLines('visitstockholm.html')
# Turn the lines into a single string
html <- paste0(lines, collapse = '\n')
dom <- htmlParse(page_content)
grepl("The Hornstull Market", page_content)
library(httr)
library(XML)
# Fetch the Visit Stockholm events page
url <- "https://www.visitstockholm.com/events/"
response <- GET(url)
# Check if the request worked
response$status_code
# Convert the response content into text
html <- content(response, as = "text", encoding = "UTF-8")
# Write it to a file
writeLines(html, "visitstockholm.html")
# At a later point, read it back in
lines <- readLines("visitstockholm.html", encoding = "UTF-8")
# Turn the lines into a single string again
html <- paste0(lines, collapse = "\n")
# Parse the HTML into a DOM tree
dom <- htmlParse(html)
# Check whether a specific event is present in the HTML
grepl("The Hornstull Market", html)
# Save the whole response object as .rds
saveRDS(response, "visitstockholm_response.rds")
# Load the full response again
response <- readRDS("visitstockholm_response.rds")

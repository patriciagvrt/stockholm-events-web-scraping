x <- str_replace_all(x, "ÃƒÂ±", "ñ")
x <- str_replace_all(x, "ÃƒÂ", "í")
x <- str_replace_all(x, "ÃƒÂ³", "ó")
x <- str_replace_all(x, "ÃƒÂ§", "ç")
x <- str_replace_all(x, "â€", "”")
x <- str_replace_all(x, "�", "é")
x <- str_squish(x)
return(x)
}
# Clean page-level datasets first
books_df <- books_df %>%
mutate(across(where(is.character), fix_encoding))
book_details_df <- book_details_df %>%
mutate(across(where(is.character), fix_encoding))
# Save detail-page data separately
write.csv(book_details_df, "goodreads_book_details_100.csv", row.names = FALSE)
# 10. Combine main list data with detail page data
books_final <- left_join(books_df, book_details_df, by = "book_link")
# Clean final dataset too, including pages_raw from detail pages
books_final <- books_final %>%
mutate(across(where(is.character), fix_encoding))
# Manual fixes for remaining encoding problems
books_final$title <- str_replace_all(
books_final$title,
"Les Mis.rables",
"Les Misérables"
)
books_final$title <- str_replace_all(
books_final$title,
"Sh.*gun \\(Asian Saga, #1\\)",
"Shōgun (Asian Saga, #1)"
)
# Additional quality checks for remaining encoding issues
encoding_check <- books_final %>%
select(where(is.character)) %>%
summarise(across(everything(),
~ sum(str_detect(.x, "Ã|Â|â|�"), na.rm = TRUE)))
encoding_check
# Show rows that may still contain encoding problems
problem_rows <- books_final %>%
filter(if_any(where(is.character),
~ str_detect(.x, "Ã|Â|â|�")))
problem_rows %>%
select(title, ratings_raw, publication_date,
pages_raw, reviews_raw) %>%
head(30)
##
# 11. Check cleaning
books_df$title[c(23, 25, 32, 38, 40)]
books_final$title[c(23, 25, 32, 38, 40)]
head(books_df$ratings_raw)
head(books_final$ratings_raw)
# 12. Inspect final data
head(books_final)
nrow(books_final)
summary(books_final)
str(books_final)
# 13. Save clean data to disk
write.csv(
books_df,"C:/Users/paty_/Downloads",
row.names = FALSE
)

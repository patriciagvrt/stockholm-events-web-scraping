################################## Project 1 ##################################
# Digital Strategies for the Social Sciences
# Project 1: Scraping event information from Visit Stockholm
# Name: Patricia Givort Cruz Cabral
# LIU-ID: patgi434
#
# Website: https://www.visitstockholm.com/events/
#
# The idea here is to build a dataset of events happening in Stockholm between
# May and July 2026 by scraping the Visit Stockholm events page across all
# pagination pages. I download the HTML, extract the event information, clean
# it, visit each event subpage, enrich it with geocoordinates from an API,
# and save the final dataset.
###############################################################################
# 1. PACKAGES
# httr to send HTTP requests, XML to parse HTML, stringi for encoding checks,
# jsonlite to work with the API response, readr to save the final CSV,
# and gt to export summary tables as images for the report.
# Uncomment the line below to install packages if needed:
# install.packages(c("httr", "XML", "stringi", "jsonlite", "readr", "gt"))
library(httr)
library(XML)
library(stringi)
library(jsonlite)
library(readr)
library(gt)
# 2. WORKING DIRECTORY
# Change this path to wherever you want to save the output files.
# If you run this on a different computer, update this line.
getwd()
# setwd("~/GitHub/Digital-Strategies-for-Social-Science-Research/project2")
getwd()
# 3. DEFINE THE DATE-FILTERED URL AND DETECT HOW MANY PAGES THERE ARE
#
# Instead of scraping only the events available on a single page at one moment
# in time, I use the date filter parameters to request all events from
# mid-May to end of July 2026. The server filters the results and returns
# them as plain HTML — no JavaScript interaction needed.
#
# The page shows 16 events per page. To get all events I need to loop through
# all pagination pages. I first fetch page 1 to find the total number of pages.
date_from <- "2026-05-14"
date_to   <- "2026-07-31"
base_url <- "https://www.visitstockholm.com/events/"
# Building the URL for page 1.
# The pagination pattern for this site is /events/page/N/?date_from=...&date_to=...
# Page 1 uses the base URL without /page/N/.
page1_url <- paste0(base_url, "?date_from=", date_from, "&date_to=", date_to)
response_p1 <- GET(page1_url)
response_p1$status_code
html_p1 <- content(response_p1, as = "text", encoding = "UTF-8")
# Saving page 1 locally.
writeLines(html_p1, "visitstockholm_page1.html")
# Parsing page 1 to find the total number of pages.
# The pagination links show the last page number, which I extract with regex.
dom_p1 <- htmlParse(html_p1)
# Extracting all pagination link texts to find the highest page number.
# The page links are numbers in the pagination bar at the bottom.
total_events_text <- regmatches(
html_p1,
regexpr("Showing\\s+(\\d+)\\s+events", html_p1)
)
total_events_text
# Extracting the number of total events.
total_events <- as.integer(regmatches(
total_events_text,
regexpr("\\d+", total_events_text)
))
total_events
# Each page shows 16 events, so I calculate the total number of pages.
# ceiling() rounds up to make sure I include the last partial page.
events_per_page <- 16
total_pages <- ceiling(total_events / events_per_page)
total_pages
# Printing a summary before starting.
print(paste("Total events found:", total_events))
print(paste("Total pages to scrape:", total_pages))
# 4. LOOP THROUGH ALL PAGES AND EXTRACT EVENT NAMES, LINKS, CATEGORIES,
#    DATES, AND LOCATIONS
#
# I collect all the event information from all listing pages before visiting
# individual subpages. This way, if something goes wrong with a subpage, I
# already have the main dataset saved.
all_event_names      <- c()
all_event_links      <- c()
all_event_categories <- c()
all_event_dates      <- c()
all_event_locations  <- c()
month_pattern <- "Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec"
for (p in 1:total_pages) {
print(paste("Scraping listing page", p, "of", total_pages))
# Building the URL for each page.
# Page 1 uses the base URL, pages 2+ use the /page/N/ pattern.
if (p == 1) {
page_url <- paste0(base_url, "?date_from=", date_from, "&date_to=", date_to)
} else {
page_url <- paste0(base_url, "page/", p, "/?date_from=", date_from, "&date_to=", date_to)
}
page_response <- GET(page_url)
# If the page doesn't return 200, skip it and move on.
if (page_response$status_code != 200) {
print(paste("Page", p, "returned status", page_response$status_code, "- skipping"))
next
}
page_html <- content(page_response, as = "text", encoding = "UTF-8")
page_dom <- htmlParse(page_html)
# Extracting all links and keeping only event page links.
# I use a regular expression to filter out navigation and footer links.
all_links <- xpathSApply(page_dom, "//a", xmlGetAttr, "href")
event_links <- all_links[
grepl("https://www.visitstockholm.com/events/.+/next/", all_links)
]
# Extracting all text elements and finding the Calendar icon pattern.
# The same anchor-based extraction method as the original script.
all_text <- xpathSApply(page_dom, "//*[text()]", xmlValue)
all_text <- trimws(all_text)
all_text <- all_text[all_text != ""]
calendar_positions <- which(all_text == "Calendar icon")
# Keeping only Calendar icons that are followed by a real date.
# This removes the Calendar icon from the filter bar at the top.
calendar_positions <- calendar_positions[
grepl(month_pattern, all_text[calendar_positions + 1])
]
# Extracting event info based on the fixed offset pattern around "Calendar icon".
# category  = 2 positions before
# event name = 1 position before
# date       = 1 position after
# location   = 3 positions after
event_categories <- all_text[calendar_positions - 2]
event_names      <- all_text[calendar_positions - 1]
event_dates      <- all_text[calendar_positions + 1]
event_locations  <- all_text[calendar_positions + 3]
# Checking that the number of events extracted matches the number of links.
# If not, something is off on this page and I print a warning.
n <- min(length(event_names), length(event_links))
if (length(event_names) != length(event_links)) {
print(paste("Warning: page", p, "has", length(event_names),
"names and", length(event_links), "links — using first", n))
}
# Appending this page's results to the full vectors.
all_event_names      <- c(all_event_names,      event_names[1:n])
all_event_links      <- c(all_event_links,      event_links[1:n])
all_event_categories <- c(all_event_categories, event_categories[1:n])
all_event_dates      <- c(all_event_dates,      event_dates[1:n])
all_event_locations  <- c(all_event_locations,  event_locations[1:n])
# Polite pause between requests.
Sys.sleep(2)
}
print(paste("Finished listing pages. Total events collected:", length(all_event_names)))
# 5. BUILD THE INITIAL DATASET
events_df <- data.frame(
event_name = all_event_names,
category   = all_event_categories,
date       = all_event_dates,
location   = all_event_locations,
link       = all_event_links,
stringsAsFactors = FALSE
)
dim(events_df)
head(events_df)
# 6. CLEAN THE DATASET
#
# Removing duplicates first — some events appear on multiple pages
# because the site shows "popular" and "featured" events on every page.
events_df_clean <- events_df[!duplicated(events_df[, c("event_name", "link")]), ]
row.names(events_df_clean) <- NULL
print(paste("After removing duplicates:", nrow(events_df_clean), "events"))
# Keeping only rows with a valid known category.
# The text extraction sometimes picks up section headers or other text
# that is not a real category.
valid_categories <- c(
"Festivals",
"Family",
"Eat & Drink",
"Music",
"Fairs",
"Exhibitions",
"Sports & Wellbeing",
"Stage & Film",
"Networking & Community",
"Clubs & Parties",
"Guided tours",
"Science & Tech",
"Christmas & New Year's",
"Careers & Leadership",
"Gaming & Boardgames",
# The full date-range scrape also picks up subcategories the site uses
# such as Pop, Jazz & Blues, Stand-up & Spoken Word, etc.
# I keep these too since they are real categories on the website.
"Pop",
"Jazz & Blues",
"Stand-up & Spoken Word",
"Hip hop, Soul & RnB",
"Hard Rock & Metal",
"Indie & Punk",
"Dance & Electronic",
"Dance & Circus",
"Classical music",
"Folk & Country",
"World Music",
"R&B & Soul",
"Rock",
"Electronic",
"Opera & Musical"
)
events_df_clean <- events_df_clean[events_df_clean$category %in% valid_categories, ]
row.names(events_df_clean) <- NULL
print(paste("After category filter:", nrow(events_df_clean), "events"))
unique(events_df_clean$category)
dim(events_df_clean)
# Saving a quick version of the table for the report.
events_sample_table <- head(events_df_clean[, c("event_name", "category", "date", "location")], 10) |>
gt() |>
tab_header(title = "Sample of the scraped events dataset (May–July 2026)")
gtsave(events_sample_table, "events_sample_table.png")
# 7. CREATE A REGEX VARIABLE FOR EVENT DURATION TYPE
#
# Using a regular expression to classify events as single-day or multi-day.
# If the date string contains a dash (like "May 14 - Jul 31"), it spans
# multiple days. If there is no dash, it is just one day.
events_df_clean$event_duration_type <- ifelse(
grepl("-", events_df_clean$date),
"Multi-day event",
"Single-day event"
)
# Checking the result.
table(events_df_clean$event_duration_type)
# Saving a summary table for the report.
duration_df <- as.data.frame(table(events_df_clean$event_duration_type))
names(duration_df) <- c("event_duration_type", "number_of_events")
duration_table <- duration_df |>
gt() |>
tab_header(title = "Number of events by duration type")
gtsave(duration_table, "duration_type_table.png")
# 8. VISIT INDIVIDUAL EVENT SUBPAGES
#
# Looping through each event link and visiting the individual subpage
# to extract the description, venue name, street address, postal code,
# and city. This is what makes the scraper visit more than one page.
#
# Note: with ~500 events and a 1-second pause this loop takes a while.
# I recommend running it once and saving the result immediately after.
subpage_title        <- c()
subpage_status       <- c()
event_description    <- c()
subpage_venue        <- c()
subpage_street_address <- c()
subpage_postal_code  <- c()
subpage_city         <- c()
for (i in 1:nrow(events_df_clean)) {
event_url <- events_df_clean$link[i]
print(paste("Downloading subpage", i, "of", nrow(events_df_clean)))
event_response <- GET(event_url)
subpage_status[i] <- event_response$status_code
event_html <- content(event_response, as = "text", encoding = "UTF-8")
event_dom <- htmlParse(event_html)
# Extracting the h1 title from the subpage.
title <- xpathSApply(event_dom, "//h1", xmlValue)
title <- trimws(title)
if (length(title) == 0) { title <- NA }
subpage_title[i] <- title[1]
# All text elements from the subpage.
page_text <- xpathSApply(event_dom, "//*[text()]", xmlValue)
page_text <- trimws(page_text)
page_text <- page_text[page_text != ""]
# Event description: appears right before "All dates" in the text order.
all_dates_position <- which(page_text == "All dates")
if (length(all_dates_position) > 0) {
event_description[i] <- page_text[all_dates_position[1] - 1]
} else {
event_description[i] <- NA
}
# Address: follows "Getting there" heading.
# Pattern: Getting there → Location icon → venue → street address → [postal code] → city
# Some pages include a postal code, some don't, so I check with regex.
getting_there_position <- which(page_text == "Getting there")
if (length(getting_there_position) > 0) {
pos <- getting_there_position[1]
subpage_venue[i]          <- page_text[pos + 2]
subpage_street_address[i] <- page_text[pos + 3]
possible_postal_code <- page_text[pos + 4]
possible_city        <- page_text[pos + 5]
# Swedish postal codes are 3 digits, optional space, 2 digits (e.g. "121 77").
postal_code_pattern <- "^\\d{3}\\s?\\d{2}$"
if (grepl(postal_code_pattern, possible_postal_code)) {
subpage_postal_code[i] <- possible_postal_code
subpage_city[i]        <- possible_city
} else {
subpage_postal_code[i] <- NA
subpage_city[i]        <- possible_postal_code
}
} else {
subpage_venue[i]          <- NA
subpage_street_address[i] <- NA
subpage_postal_code[i]    <- NA
subpage_city[i]           <- NA
}
Sys.sleep(1)
}
# Adding the subpage columns to the clean dataset.
events_df_clean$subpage_title    <- subpage_title
events_df_clean$subpage_status   <- subpage_status
events_df_clean$event_description <- event_description
events_df_clean$subpage_venue    <- subpage_venue
events_df_clean$street_address   <- subpage_street_address
events_df_clean$postal_code      <- subpage_postal_code
events_df_clean$city             <- subpage_city
# Quick check of what we got.
events_df_clean[, c("event_name", "location", "subpage_venue",
"street_address", "postal_code", "city", "subpage_status")]
# 9. DOWNLOAD ONE EVENT IMAGE (non-text file)
#
# I download the main image from the first event as an example of non-text
# file download. The image URL is in the og:image meta tag of the event page.
dir.create("event_images", showWarnings = FALSE)
first_event_url <- events_df_clean$link[1]
first_event_response <- GET(first_event_url)
first_event_html     <- content(first_event_response, as = "text", encoding = "UTF-8")
first_event_dom      <- htmlParse(first_event_html)
first_image_url <- xpathSApply(
first_event_dom,
"//meta[@property='og:image']",
xmlGetAttr,
"content"
)
if (length(first_image_url) > 0) {
image_response <- GET(
first_image_url[1],
write_disk("event_images/example_event.jpg", overwrite = TRUE)
)
print(paste("Image downloaded - status:", image_response$status_code))
} else {
print("No og:image found for first event")
}
# 10. DESCRIPTIVE ANALYSIS BY CATEGORY
category_count <- table(events_df_clean$category)
category_df <- as.data.frame(category_count)
names(category_df) <- c("category", "number_of_events")
category_df <- category_df[order(category_df$number_of_events, decreasing = TRUE), ]
category_df
# 11. DESCRIPTIVE ANALYSIS BY LOCATION
location_count <- table(events_df_clean$location)
location_df <- as.data.frame(location_count)
names(location_df) <- c("location", "number_of_events")
location_df <- location_df[order(location_df$number_of_events, decreasing = TRUE), ]
# Top 20 locations.
head(location_df, 20)
# 12. VISUALIZATION
#
# Horizontal bar chart of events by category.
# I use horizontal layout because some category names are long.
# Only showing categories with at least 2 events to keep the chart readable.
category_df_plot <- category_df[category_df$number_of_events >= 2, ]
png("visitstockholm_category_plot.png", width = 1600, height = 1000)
par(mar = c(5, 20, 4, 2))
barplot(
category_df_plot$number_of_events,
names.arg = category_df_plot$category,
horiz = TRUE,
las = 1,
main = "Visit Stockholm events by category (May–July 2026)",
xlab = "Number of events",
cex.names = 0.85
)
dev.off()
# Uncomment to view in RStudio:
# par(mar = c(5, 20, 4, 2))
# barplot(
#   category_df_plot$number_of_events,
#   names.arg = category_df_plot$category,
#   horiz = TRUE,
#   las = 1,
#   main = "Visit Stockholm events by category (May–July 2026)",
#   xlab = "Number of events",
#   cex.names = 0.85
# )
# 13. GEOCODING WITH THE NOMINATIM API
#
# Enriching the dataset with latitude and longitude using the free
# Nominatim API from OpenStreetMap. I geocode only unique addresses
# to avoid duplicate API calls.
events_df_clean$geocode_query <- ifelse(
is.na(events_df_clean$street_address),
paste(events_df_clean$location, "Stockholm, Sweden"),
paste(events_df_clean$street_address, events_df_clean$postal_code,
events_df_clean$city, "Sweden")
)
unique_queries <- unique(events_df_clean$geocode_query)
geo_df <- data.frame(
geocode_query = unique_queries,
lat = NA,
lon = NA,
stringsAsFactors = FALSE
)
for (i in 1:nrow(geo_df)) {
query <- URLencode(geo_df$geocode_query[i])
api_url <- paste0(
"https://nominatim.openstreetmap.org/search?q=",
query,
"&format=json&limit=1"
)
print(paste("Geocoding address", i, "of", nrow(geo_df)))
# Nominatim requires a User-Agent header — without it the API rejects the request.
api_response <- GET(
api_url,
add_headers("User-Agent" = "visit-stockholm-student-project/1.0")
)
api_text <- content(api_response, as = "text", encoding = "UTF-8")
api_json <- fromJSON(api_text)
if (length(api_json) > 0 && nrow(api_json) > 0) {
geo_df$lat[i] <- api_json$lat[1]
geo_df$lon[i] <- api_json$lon[1]
}
# Nominatim's usage policy asks for no more than one request per second.
Sys.sleep(1)
}
# Merging coordinates back into the main dataset.
events_df_final <- merge(
events_df_clean,
geo_df,
by = "geocode_query",
all.x = TRUE
)
# Removing the helper geocode_query column.
events_df_final$geocode_query <- NULL
dim(events_df_final)
head(events_df_final)
# 14. SAVE THE FINAL DATASET
#
# Using write_excel_csv() instead of write_csv() because it adds a BOM
# (byte order mark) at the start of the file, which helps Excel open the
# file and display Swedish characters like å, ä, ö correctly.
# I had this problem with write_csv and this fixed it.
write_excel_csv(
events_df_final,
"visitstockholm_events_may_july_2026.csv"
)
print(paste("Done! Final dataset has", nrow(events_df_final),
"events saved to visitstockholm_events_may_july_2026.csv"))
